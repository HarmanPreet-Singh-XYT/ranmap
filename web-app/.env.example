# Same Supabase project as the mobile app and server/ — shared user pool.
# NEXT_PUBLIC_ because both values must reach the browser client; the
# publishable key is safe to ship client-side (RLS enforces access, not this
# key). Never put a secret/service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
