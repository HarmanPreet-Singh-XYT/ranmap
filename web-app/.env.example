# Same Supabase project as the mobile app and server/ — shared user pool.
# NEXT_PUBLIC_ because both values must reach the browser client; the
# publishable key is safe to ship client-side (RLS enforces access, not this
# key). Never put a secret/service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Public origin of this web app, e.g. https://ranmap.app. Used to build the
# password-reset / email-confirmation link that Supabase emails (it points at
# /auth/confirm, which exchanges the PKCE code for a session), and as the
# canonical origin for metadata, the sitemap, robots.txt and Open Graph URLs.
# If unset, Supabase falls back to the project's configured Site URL and the
# app falls back to https://ranmap.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store listings, used by the marketing "download" badges. Optional: when a
# value is unset the corresponding badge is hidden rather than linking
# somewhere unrelated.
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id000000000
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.ranmap.app

# ranmap-server base URL. Called server-side only (Server Actions/Route
# Handlers), so this is NOT NEXT_PUBLIC_ — it never needs to reach the
# browser, and keeping it server-only avoids exposing the API's location.
RANMAP_SERVER_URL=http://localhost:8787

# RevenueCat Web Billing public SDK key (from the RevenueCat dashboard —
# a client-safe *public* key, never the secret key already used server-side
# in server/.env.example as REVENUECAT_SECRET_KEY). NEXT_PUBLIC_ because the
# checkout call runs in the browser. Production keys start with "rcb_";
# sandbox keys start with "rcb_sb_". If unset, UpgradeButton falls back to a
# message pointing users at the mobile app instead of failing.
NEXT_PUBLIC_REVENUECAT_WEB_BILLING_KEY=

# Package identifier for the Pro entitlement in your RevenueCat offering —
# either a reserved id ("$rc_monthly", "$rc_annual", …) or a custom one you
# created in the dashboard. Optional: if unset, the offering's monthly package
# (else its first available package) is used.
NEXT_PUBLIC_REVENUECAT_PRO_PACKAGE_ID=
