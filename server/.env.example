PORT=8787

# Supabase project (same project as the Flutter app)
SUPABASE_URL=https://your-project.supabase.co
# Secret key (Project Settings → API Keys) — server-only, never ship to the
# client. Replaces the legacy service-role key; it bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Anthropic API key — server-only.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the model id (defaults to claude-sonnet-4-5).
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Maps web-service key (Directions + Places), server-only. Restrict it
# to a server IP in the Google Cloud console — the client never sees this.
GOOGLE_MAPS_API_KEY=your-google-maps-server-key

# Optional: comma-separated CORS origin allowlist for Flutter web. Leave unset
# for the mobile app (it uses Bearer tokens, not cookies, so CORS doesn't apply).
# CORS_ORIGIN=https://app.example.com

# Twilio Verify, for phone number OTP verification — server-only.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

# LiveKit, for voice channels — server-only (API key/secret mint join tokens).
# Use a LiveKit Cloud project (https://cloud.livekit.io) or a self-hosted server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
