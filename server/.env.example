PORT=8787

# Number of reverse-proxy hops in front of this process, used to resolve the
# real client IP for rate limiting. Defaults to 1 (one proxy). Set to 0 when the
# process is exposed directly. Do NOT set to "true" — that trusts a spoofable
# X-Forwarded-For header from any peer.
# TRUST_PROXY=1

# Supabase project (same project as the Flutter app)
SUPABASE_URL=https://your-project.supabase.co
# Secret key (Project Settings → API Keys) — server-only, never ship to the
# client. Replaces the legacy service-role key; it bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Anthropic API key — server-only.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the model id (defaults to claude-sonnet-4-5).
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Maps web-service key — used ONLY for per-place details (rating,
# review count, opening hours) when a user opens a single search result.
# Requires the Places API (New). Server-only; the client never sees this.
# Optional: without it, /maps/places/details returns 503.
# GOOGLE_MAPS_API_KEY=your-google-maps-server-key

# Mapbox token, server-only. MUST be a SECRET token (sk.…): it mints the app's
# short-lived rendering tokens, and minting needs `tokens:write`, which is a
# secret-only scope (public `pk.` tokens cannot have it). A secret token can
# hold public and secret scopes together, so give it:
#   tokens:write            (to mint temporary tokens)
#   styles:read, fonts:read, styles:tiles   (granted to the temp tokens — an
#                            authorizing token can only grant scopes it holds)
# Directions + Search Box need no scope of their own; a valid token is enough.
# Leave it unrestricted — URL restrictions make a token unusable from a server.
# Optional: without it, the map + routing routes return 503.
# MAPBOX_ACCESS_TOKEN=sk.your-mapbox-server-token
# MAPBOX_USERNAME=your-mapbox-username

# RevenueCat billing (optional — without it the app runs fine and the paywall
# just says "not available yet"). REVENUECAT_SECRET_KEY is the RevenueCat
# *secret* API key (used to read subscriber state); REVENUECAT_WEBHOOK_AUTH is
# the exact Authorization header value you configure on the RevenueCat webhook,
# which this server checks on every event.
#
# REVENUECAT_WEBHOOK_AUTH is a bare bearer secret with no per-request signature
# or replay protection — anyone holding it can POST a webhook event that
# grants Pro to an arbitrary Ranmap user id. Generate it with a CSPRNG (e.g.
# `openssl rand -hex 32`), store it the same way you store the Supabase
# service-role key (never in logs, client bundles, or shared channels), and
# rotate it (update here and in the RevenueCat dashboard together) if it is
# ever exposed.
# REVENUECAT_SECRET_KEY=sk_your_revenuecat_secret_key
# REVENUECAT_WEBHOOK_AUTH=generate-a-long-random-string

# Optional: comma-separated CORS origin allowlist for Flutter web. Leave unset
# for the mobile app (it uses Bearer tokens, not cookies, so CORS doesn't apply).
# CORS_ORIGIN=https://app.example.com

# Twilio Verify, for phone number OTP verification — server-only. Optional:
# without it, /phone/* returns 503.
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

# LiveKit, for voice channels — server-only (API key/secret mint join tokens).
# A LiveKit Cloud project (https://cloud.livekit.io) or a self-hosted server.
# Optional: without it, /voice/token returns 503.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret

# Firebase Cloud Messaging, for push notifications — server-only. Optional:
# without it devices can still register (POST /notifications/register), but no
# notification is delivered and that endpoint reports `push: false` so the app
# can be honest about it. Paste the WHOLE service-account JSON (Firebase
# console → Project settings → Service accounts → Generate new private key) as
# a single-line string. It holds a private key — treat it like
# SUPABASE_SECRET_KEY.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}
