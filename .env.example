SUPABASE_URL=https://your-project.supabase.co
# Publishable key (Project Settings → API Keys) — safe to ship in the client.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# ranmap-server (see server/) — AI assistant, phone verification, voice, map
# token vending, and the routing/places proxy.
#
# localhost works on a simulator/emulator (and on a physical device with
# `adb reverse tcp:8787 tcp:8787`). To test on a real phone over Wi-Fi, use the
# Mac's address, e.g. http://192.168.1.20:8787 or http://your-mac.local:8787.
# Debug builds allow this cleartext hop (Android: src/debug network config;
# iOS: NSAllowsLocalNetworking). Production builds should point at an https URL.
BACKEND_URL=http://localhost:8787

# Public legal pages (optional). When set, the paywall links to them; when
# omitted, the links are hidden rather than pointing at a URL that may not
# exist. App-store review expects these to be live before you ship.
# TERMS_URL=https://example.com/terms
# PRIVACY_URL=https://example.com/privacy

# RevenueCat **public** SDK keys (optional — omit both to disable billing; the
# paywall then says "not available yet"). Safe to ship; the secret key stays on
# the server. RevenueCat dashboard → Project → API keys.
# REVENUECAT_IOS_KEY=appl_your_public_sdk_key
# REVENUECAT_ANDROID_KEY=goog_your_public_sdk_key

# The 3D map's Mapbox token is NOT stored in the app: ranmap-server vends a
# short-lived temporary token at runtime (GET /maps/token), so the app ships no
# long-lived Mapbox credential to leak or rotate. Configure it in server/.env.
#
# Android still needs a *secret* downloads token (sk.…) to pull the Mapbox SDK
# from Mapbox's Maven repo; set MAPBOX_DOWNLOADS_TOKEN in
# ~/.gradle/gradle.properties (never commit it), see android/build.gradle.kts.

# NOTE: the Google Maps *SDK* key that used to render the native map is no
# longer used — the map is now rendered by the Mapbox Maps SDK for Flutter.
# The Google web-service key (Directions/Places) still lives only on
# ranmap-server, never in the app.
