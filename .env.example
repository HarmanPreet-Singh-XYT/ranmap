SUPABASE_URL=https://your-project.supabase.co
# Publishable key (Project Settings → API Keys) — safe to ship in the client.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# ranmap-server (see server/) — AI assistant, phone verification, voice, and
# the Google Directions/Places proxy.
BACKEND_URL=http://localhost:8787

# Mapbox public access token (pk.…) for the 3D map. Create one at
# https://console.mapbox.com/account/access-tokens/ — a public token is safe to
# ship in the client. Note: Android builds additionally need a *secret*
# downloads token (sk.…) to pull the Mapbox SDK from Mapbox's Maven repo; set
# MAPBOX_DOWNLOADS_TOKEN in ~/.gradle/gradle.properties (never commit it), see
# android/build.gradle.kts.
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# NOTE: the Google Maps *SDK* key that used to render the native map is no
# longer used — the map is now rendered by the Mapbox Maps SDK for Flutter.
# The Google web-service key (Directions/Places) still lives only on
# ranmap-server, never in the app.
